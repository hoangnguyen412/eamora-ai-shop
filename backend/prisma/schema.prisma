generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   // buyer / seller
  autoBuyEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  orders       Order[]
  reviews      Review[]
  interactions Interaction[]
  watchlist    Watchlist[]
}

model Shop {
  id              String    @id @default(uuid())
  sellerId        String
  name            String
  description     String?
  reputationScore Float     @default(0)
  listings        Listing[]

  @@index([sellerId])
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  categoryId  String
  name        String
  description String?
  specs       Json?
  basePrice   Float
  imageUrl    String?
  brand       String?
  category    Category    @relation(fields: [categoryId], references: [id])
  listings    Listing[]
  reviews     Review[]
  embeddings  Embedding[]
  watchlist   Watchlist[]

  @@index([categoryId])
}

model Listing {
  id         String         @id @default(uuid())
  productId  String
  shopId     String
  price      Float
  stock      Int
  condition  String   @default("new")
  createdAt  DateTime @default(now())
  product    Product        @relation(fields: [productId], references: [id])
  shop       Shop           @relation(fields: [shopId], references: [id])
  priceHistory PriceHistory[]
  orderItems   OrderItem[]

  @@index([productId, stock, price])
  @@index([shopId])
}

model Order {
  id            String      @id @default(uuid())
  buyerId       String
  totalAmount   Float
  status        String      // pending, processing, shipped, delivered, cancelled
  shippingInfo  Json?
  paymentMethod String      @default("cod")
  createdAt     DateTime    @default(now())
  buyer         User        @relation(fields: [buyerId], references: [id])
  items         OrderItem[]

  @@index([buyerId, createdAt])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  listingId String
  quantity  Int
  price     Float
  order     Order  @relation(fields: [orderId], references: [id])
  listing   Listing @relation(fields: [listingId], references: [id])

  @@index([orderId])
  @@index([listingId])
}

model Review {
  id        String  @id @default(uuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  isFake    Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@index([productId])
}

model Interaction {
  id        String   @id @default(uuid())
  userId    String
  productId String
  action    String   // view, click, cart, buy
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// --- AI & AGENT ENTITIES ---

model SearchSession {
  id        String   @id @default(uuid())
  userId    String?
  queryText String
  filters   Json?
  createdAt DateTime @default(now())
  clicks    SearchClick[]
}

model SearchClick {
  id        String       @id @default(uuid())
  sessionId String
  productId String
  createdAt DateTime     @default(now())
  session   SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id                 String   @id @default(uuid())
  sessionId          String
  role               String   // user / assistant
  content            String
  retrievedProducts  Json?
  createdAt          DateTime @default(now())
}

model Embedding {
  id        String  @id @default(uuid())
  productId String
  vector    Unsupported("vector(768)")
  updatedAt DateTime @default(now()) @updatedAt
  product   Product @relation(fields: [productId], references: [id])
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  targetPrice Float
  status      String   @default("active")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  queueItems  AutoBuyQueueItem[]

  @@index([userId, createdAt])
}

model AutoBuyQueueItem {
  id          String   @id @default(uuid())
  watchlistId String
  status      String   @default("pending")
  result      Json?
  createdAt   DateTime @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([watchlistId, status])
}

model PriceHistory {
  id        String   @id @default(uuid())
  listingId String
  price     Float
  recordedAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId, recordedAt])
}
